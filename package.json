{
  "name": "api-restful-favoritos",
  "version": "2.0.0",
  "description": "API RESTful de favoritos con Node.js, Express 5 y MongoDB",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --env-file-if-exists=.env.test --test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down"
  },
  "author": "Carlos Alberto (carlosalbertoxw)",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "mongoose": "^9.7.3",
    "morgan": "^1.11.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "supertest": "^7.2.2"
  }
}
