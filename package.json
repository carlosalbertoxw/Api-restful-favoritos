{
  "name": "api-restful-favoritos",
  "version": "3.0.0",
  "description": "API RESTful de favoritos con Node.js, Express 5 y MongoDB",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --env-file-if-exists=.env.test --import ./tests/setup.js --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "test:unit": "node --env-file-if-exists=.env.test --import ./tests/setup.js --test \"tests/unit/**/*.test.js\"",
    "test:integration": "node --env-file-if-exists=.env.test --import ./tests/setup.js --test --test-concurrency=1 \"tests/integration/**/*.test.js\"",
    "test:coverage": "node --env-file-if-exists=.env.test --import ./tests/setup.js --test --test-concurrency=1 --experimental-test-coverage --test-coverage-exclude=\"tests/**\" --test-coverage-exclude=\"src/server.js\" --test-coverage-lines=90 --test-coverage-branches=85 --test-coverage-functions=90 \"tests/**/*.test.js\"",
    "db:up": "docker compose up -d mongo",
    "db:down": "docker compose down",
    "docker:up": "docker compose up -d --build --wait",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f api"
  },
  "author": "Carlos Alberto (carlosalbertoxw)",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "mongoose": "^9.11.4",
    "morgan": "^1.12.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  }
}
