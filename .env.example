# Puerto en el que escucha el servidor
PORT=5000

# Cadena de conexión a MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/bookmarks

# Orígenes permitidos por CORS. Sin definir, la API no envía cabeceras CORS
# (el frontend la usa desde su mismo origen, con el proxy de nginx o de ng serve).
# Usa "*" para todos o una lista separada por comas: https://midominio.com,https://otro.com
# CORS_ORIGIN=

# Peticiones por minuto y por IP permitidas en /api
RATE_LIMIT_PER_MINUTE=100

# Proxies de confianza delante de la API, para leer la IP real del cliente.
# Número de saltos o redes con la sintaxis de Express ("uniquelocal" para la red de Docker).
# Sin definir, no se confía en ningún proxy.
# TRUST_PROXY=
